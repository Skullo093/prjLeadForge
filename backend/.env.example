# Banco de dados (SQLite em desenvolvimento)
LEADFORGE_DATABASE_URL=sqlite:///./leadforge.db

# Chave usada para assinar os tokens de login. Troque por um valor longo e aleatório.
LEADFORGE_SECRET_KEY=troque-esta-chave

# Modo de operação: auto | demo | live
#   demo: empresas e sites simulados, sem precisar de chaves ou internet
#   live: Geoapify e análise real dos sites
#   auto: usa live quando houver chave do Geoapify, senão demo
LEADFORGE_MODE=auto

# API de lugares (Geoapify). Nunca commite a chave.
LEADFORGE_GEOAPIFY_API_KEY=

# Origens permitidas no navegador (frontend)
LEADFORGE_CORS_ORIGINS=["http://localhost:5173"]
